%General Mission Analysis Tool(GMAT) Script
%  Diagnostic (not a physics cross-check): extract GMAT's ACTUAL Mars
%  body-fixed orientation (full IAU model, including whatever periodic
%  nutation/precession terms GMAT applies) at the KSROP-Mars GMAT
%  cross-validation test epoch, by reporting TWO non-collinear position
%  vectors at the SAME epoch in both MarsMJ2000Eq (inertial, parallel
%  to EME2000) and MarsFixed (body-fixed) axes. From those two vector
%  pairs the rotation matrix (and hence GMAT's actual pole RA/Dec/W)
%  can be recovered directly -- sidesteps needing to hand-derive the
%  PCK nutation-angle unit convention (T in centuries vs d in days)
%  from the raw SPICEPlanetaryConstantsKernel.tpc coefficients, and
%  avoids the rotating-frame velocity-transform complication.

Create Spacecraft SC1;
GMAT SC1.DateFormat = UTCGregorian;
GMAT SC1.Epoch = '10 Aug 2026 00:00:00.000';

Create Spacecraft SC2;
GMAT SC2.DateFormat = UTCGregorian;
GMAT SC2.Epoch = '10 Aug 2026 00:00:00.000';

Create CoordinateSystem MarsMJ2000Eq;
GMAT MarsMJ2000Eq.Origin = Mars;
GMAT MarsMJ2000Eq.Axes = MJ2000Eq;

Create CoordinateSystem MarsFixedCS;
GMAT MarsFixedCS.Origin = Mars;
GMAT MarsFixedCS.Axes = BodyFixed;

GMAT SC1.CoordinateSystem = MarsMJ2000Eq;
GMAT SC1.DisplayStateType = Cartesian;
GMAT SC1.X = 1.000000000;
GMAT SC1.Y = 0.000000000;
GMAT SC1.Z = 0.000000000;
GMAT SC1.VX = 0.0;
GMAT SC1.VY = 0.0;
GMAT SC1.VZ = 0.0;

GMAT SC2.CoordinateSystem = MarsMJ2000Eq;
GMAT SC2.DisplayStateType = Cartesian;
GMAT SC2.X = 0.000000000;
GMAT SC2.Y = 1.000000000;
GMAT SC2.Z = 0.000000000;
GMAT SC2.VX = 0.0;
GMAT SC2.VY = 0.0;
GMAT SC2.VZ = 0.0;

Create Spacecraft SC3;
GMAT SC3.DateFormat = UTCGregorian;
GMAT SC3.Epoch = '10 Aug 2026 00:00:00.000';
GMAT SC3.CoordinateSystem = MarsMJ2000Eq;
GMAT SC3.DisplayStateType = Cartesian;
GMAT SC3.X = 0.000000000;
GMAT SC3.Y = 0.000000000;
GMAT SC3.Z = 1.000000000;
GMAT SC3.VX = 0.0;
GMAT SC3.VY = 0.0;
GMAT SC3.VZ = 0.0;

Create ReportFile RepOrient;
GMAT RepOrient.Filename = 'mars_orientation_gmat.txt';
GMAT RepOrient.Precision = 16;
GMAT RepOrient.WriteHeaders = true;

BeginMissionSequence;

Report RepOrient SC1.A1ModJulian SC1.MarsMJ2000Eq.X SC1.MarsMJ2000Eq.Y SC1.MarsMJ2000Eq.Z SC1.MarsFixedCS.X SC1.MarsFixedCS.Y SC1.MarsFixedCS.Z;
Report RepOrient SC2.A1ModJulian SC2.MarsMJ2000Eq.X SC2.MarsMJ2000Eq.Y SC2.MarsMJ2000Eq.Z SC2.MarsFixedCS.X SC2.MarsFixedCS.Y SC2.MarsFixedCS.Z;
Report RepOrient SC3.A1ModJulian SC3.MarsMJ2000Eq.X SC3.MarsMJ2000Eq.Y SC3.MarsMJ2000Eq.Z SC3.MarsFixedCS.X SC3.MarsFixedCS.Y SC3.MarsFixedCS.Z;
