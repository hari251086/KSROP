%General Mission Analysis Tool(GMAT) Script
%  Cross-validation of driver_KS.F two-body test case (test_driver.py)
%  Pure point-mass Earth gravity, no J2/drag/SRP -- matches KSROP
%  input/const_new.dat + input/input.opm + input/input.dat (2-body test)

%----------------------------------------
%---------- Spacecraft
%----------------------------------------

Create Spacecraft DefaultSC;
GMAT DefaultSC.DateFormat = UTCGregorian;
GMAT DefaultSC.Epoch = '20 Sep 2016 00:00:00.000';
GMAT DefaultSC.CoordinateSystem = EarthMJ2000Eq;
GMAT DefaultSC.DisplayStateType = Cartesian;
GMAT DefaultSC.X = 0.000000;
GMAT DefaultSC.Y = -5888.972700;
GMAT DefaultSC.Z = -3400.000000;
GMAT DefaultSC.VX = 9.500000000;
GMAT DefaultSC.VY = 0.000000000;
GMAT DefaultSC.VZ = 0.000000000;

%----------------------------------------
%---------- ForceModel: point-mass Earth only (no J2, no drag, no SRP)
%----------------------------------------

Create ForceModel TwoBodyFM;
GMAT TwoBodyFM.CentralBody = Earth;
GMAT TwoBodyFM.PointMasses = {Earth};
GMAT TwoBodyFM.Drag = None;
GMAT TwoBodyFM.SRP = Off;
GMAT TwoBodyFM.RelativisticCorrection = Off;
GMAT TwoBodyFM.ErrorControl = RSSStep;

%----------------------------------------
%---------- Propagator: high-precision RK89 (~matches KS tol=1e-15)
%----------------------------------------

Create Propagator TwoBodyProp;
GMAT TwoBodyProp.FM = TwoBodyFM;
GMAT TwoBodyProp.Type = RungeKutta89;
GMAT TwoBodyProp.InitialStepSize = 10;
GMAT TwoBodyProp.Accuracy = 1e-13;
GMAT TwoBodyProp.MinStep = 0;
GMAT TwoBodyProp.MaxStep = 60;
GMAT TwoBodyProp.MaxStepAttempts = 50;

%----------------------------------------
%---------- Report of state at each KSROP checkpoint
%----------------------------------------

Create ReportFile Rep;
GMAT Rep.Filename = 'crosscheck_gmat.txt';
GMAT Rep.Precision = 16;
GMAT Rep.WriteHeaders = true;
GMAT Rep.ColumnWidth = 24;
GMAT Rep.Add = {DefaultSC.UTCGregorian, DefaultSC.ElapsedSecs, DefaultSC.EarthMJ2000Eq.X, DefaultSC.EarthMJ2000Eq.Y, DefaultSC.EarthMJ2000Eq.Z, DefaultSC.EarthMJ2000Eq.VX, DefaultSC.EarthMJ2000Eq.VY, DefaultSC.EarthMJ2000Eq.VZ};

%----------------------------------------
%---------- Mission Sequence: propagate to each KSROP checkpoint (absolute ElapsedSecs)
%----------------------------------------

BeginMissionSequence;

Report Rep DefaultSC.UTCGregorian DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate TwoBodyProp(DefaultSC) {DefaultSC.ElapsedSecs = 884.673};
Report Rep DefaultSC.UTCGregorian DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate TwoBodyProp(DefaultSC) {DefaultSC.ElapsedSecs = 1229.173};
Report Rep DefaultSC.UTCGregorian DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate TwoBodyProp(DefaultSC) {DefaultSC.ElapsedSecs = 1786.585};
Report Rep DefaultSC.UTCGregorian DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate TwoBodyProp(DefaultSC) {DefaultSC.ElapsedSecs = 2343.998};
Report Rep DefaultSC.UTCGregorian DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate TwoBodyProp(DefaultSC) {DefaultSC.ElapsedSecs = 2688.498};
Report Rep DefaultSC.UTCGregorian DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate TwoBodyProp(DefaultSC) {DefaultSC.ElapsedSecs = 2688.497};
Report Rep DefaultSC.UTCGregorian DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate TwoBodyProp(DefaultSC) {DefaultSC.ElapsedSecs = 2343.998};
Report Rep DefaultSC.UTCGregorian DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate TwoBodyProp(DefaultSC) {DefaultSC.ElapsedSecs = 1786.585};
Report Rep DefaultSC.UTCGregorian DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate TwoBodyProp(DefaultSC) {DefaultSC.ElapsedSecs = 1229.173};
Report Rep DefaultSC.UTCGregorian DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate TwoBodyProp(DefaultSC) {DefaultSC.ElapsedSecs = 884.673};
Report Rep DefaultSC.UTCGregorian DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
