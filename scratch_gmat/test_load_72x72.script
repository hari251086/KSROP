%General Mission Analysis Tool(GMAT) Script
%  Sanity check: load EGM2008_72x72.cof and propagate a few steps

Create Spacecraft DefaultSC;
GMAT DefaultSC.DateFormat = UTCGregorian;
GMAT DefaultSC.Epoch = '20 Sep 2016 00:00:00.000';
GMAT DefaultSC.CoordinateSystem = EarthMJ2000Eq;
GMAT DefaultSC.DisplayStateType = Cartesian;
GMAT DefaultSC.X = 0.000000;
GMAT DefaultSC.Y = -5888.972700;
GMAT DefaultSC.Z = -3400.000000;
GMAT DefaultSC.VX = 9.500000000;
GMAT DefaultSC.VY = 0.000000000;
GMAT DefaultSC.VZ = 0.000000000;

Create ForceModel FM72;
GMAT FM72.CentralBody = Earth;
GMAT FM72.PrimaryBodies = {Earth};
GMAT FM72.GravityField.Earth.Degree = 72;
GMAT FM72.GravityField.Earth.Order = 0;
GMAT FM72.GravityField.Earth.PotentialFile = 'C:\Users\hari2\OneDrive\Documents\GitHub\KSROP\scratch_gmat\EGM2008_72x72.cof';
GMAT FM72.Drag = None;
GMAT FM72.SRP = Off;

Create Propagator Prop72;
GMAT Prop72.FM = FM72;
GMAT Prop72.Type = RungeKutta89;
GMAT Prop72.InitialStepSize = 10;
GMAT Prop72.Accuracy = 1e-13;
GMAT Prop72.MaxStep = 60;

Create ReportFile Rep72;
GMAT Rep72.Filename = 'crosscheck_72x72_load.txt';
GMAT Rep72.Precision = 16;
GMAT Rep72.WriteHeaders = true;

BeginMissionSequence;

Report Rep72 DefaultSC.UTCGregorian DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate Prop72(DefaultSC) {DefaultSC.ElapsedSecs = 884.673};
Report Rep72 DefaultSC.UTCGregorian DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
