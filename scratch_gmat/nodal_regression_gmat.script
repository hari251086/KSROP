%General Mission Analysis Tool(GMAT) Script
%  Independent GMAT validation of J2-only nodal regression rate for the
%  near-polar test orbit (a~7209km, e=0.00206, i=98.7147deg), matching
%  driver_KS.F's ngeo_deg=2 test case. Order=0 for pure zonal J2 (no
%  tesseral coupling), consistent with KSROP's zonal-only geo_coeff model.

Create Spacecraft DefaultSC;
GMAT DefaultSC.DateFormat = UTCGregorian;
GMAT DefaultSC.Epoch = '20 Sep 2016 00:00:00.000';
GMAT DefaultSC.CoordinateSystem = EarthMJ2000Eq;
GMAT DefaultSC.DisplayStateType = Cartesian;
GMAT DefaultSC.X = -4120.646041796;
GMAT DefaultSC.Y = -1378.729647719;
GMAT DefaultSC.Z = 5733.604353381;
GMAT DefaultSC.VX = 4.858505092;
GMAT DefaultSC.VY = 3.596641258;
GMAT DefaultSC.VZ = 4.356592149;

Create ForceModel FMJ2;
GMAT FMJ2.CentralBody = Earth;
GMAT FMJ2.PrimaryBodies = {Earth};
GMAT FMJ2.GravityField.Earth.Degree = 2;
GMAT FMJ2.GravityField.Earth.Order = 0;
GMAT FMJ2.GravityField.Earth.PotentialFile = 'C:\Users\hari2\OneDrive\Documents\GitHub\KSROP\scratch_gmat\EGM2008_72x72.cof';
GMAT FMJ2.Drag = None;
GMAT FMJ2.SRP = Off;

Create Propagator PropJ2;
GMAT PropJ2.FM = FMJ2;
GMAT PropJ2.Type = RungeKutta89;
GMAT PropJ2.InitialStepSize = 10;
GMAT PropJ2.Accuracy = 1e-13;
GMAT PropJ2.MaxStep = 60;

Create ReportFile RepJ2;
GMAT RepJ2.Filename = 'nodal_regression_gmat.txt';
GMAT RepJ2.Precision = 16;
GMAT RepJ2.WriteHeaders = true;

BeginMissionSequence;

Report RepJ2 DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.RAAN DefaultSC.EarthMJ2000Eq.INC DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate PropJ2(DefaultSC) {DefaultSC.ElapsedSecs = 6091.398730092763};
Report RepJ2 DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.RAAN DefaultSC.EarthMJ2000Eq.INC DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate PropJ2(DefaultSC) {DefaultSC.ElapsedSecs = 6091.398730092763};
Report RepJ2 DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.RAAN DefaultSC.EarthMJ2000Eq.INC DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate PropJ2(DefaultSC) {DefaultSC.ElapsedSecs = 6091.398730092763};
Report RepJ2 DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.RAAN DefaultSC.EarthMJ2000Eq.INC DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate PropJ2(DefaultSC) {DefaultSC.ElapsedSecs = 6091.398730092763};
Report RepJ2 DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.RAAN DefaultSC.EarthMJ2000Eq.INC DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
