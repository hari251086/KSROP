%General Mission Analysis Tool(GMAT) Script
%  Phase 5 (issue #23): FULL force model cross-check vs driver_KS.F.
%  TC4 GTO (a=24371, e=0.731, i=28, argp=180), 2 revs (~21 h).
%  KSROP: J2-J20 zonal + Sun(n=2) + Moon(n=3) + drag(J70,BN=100) + SRP
%  (CR=1.2, A/m=0.01, conical shadow).
%  GMAT: Degree=20/Order=0 (same coefficients), Sun+Luna point mass
%  (DE405), JacchiaRoberts (F107=72/F107A=72/Kp=1.0), SRP (Cr=1.2,
%  SRPArea=1.1 m2, mass=110 kg -> A/m=0.01; DragArea=0.5 m2, Cd=2.2 ->
%  BN=100 kg/m2).
%  Expected agreement bounded by lunar ephemeris gap (~3.6%) + drag
%  model difference -- km-scale, not meter-scale.

Create Spacecraft DefaultSC;
GMAT DefaultSC.DateFormat = UTCGregorian;
GMAT DefaultSC.Epoch = '20 Sep 2016 00:00:00.000';
GMAT DefaultSC.CoordinateSystem = EarthMJ2000Eq;
GMAT DefaultSC.DisplayStateType = Cartesian;
GMAT DefaultSC.X = -6555.799000;
GMAT DefaultSC.Y = 0.000000;
GMAT DefaultSC.Z = 0.000000;
GMAT DefaultSC.VX = 0.000000000;
GMAT DefaultSC.VY = -9.058150532;
GMAT DefaultSC.VZ = -4.816304071;
GMAT DefaultSC.DryMass = 110;
GMAT DefaultSC.Cd = 2.2;
GMAT DefaultSC.DragArea = 0.5;
GMAT DefaultSC.Cr = 1.2;
GMAT DefaultSC.SRPArea = 1.1;

Create ForceModel FMall;
GMAT FMall.CentralBody = Earth;
GMAT FMall.PrimaryBodies = {Earth};
GMAT FMall.PointMasses = {Sun, Luna};
GMAT FMall.GravityField.Earth.Degree = 20;
GMAT FMall.GravityField.Earth.Order = 0;
GMAT FMall.GravityField.Earth.PotentialFile = 'C:\Users\hari2\OneDrive\Documents\GitHub\KSROP\scratch_gmat\EGM2008_72x72.cof';
GMAT FMall.Drag.AtmosphereModel = JacchiaRoberts;
GMAT FMall.Drag.HistoricWeatherSource = 'ConstantFluxAndGeoMag';
GMAT FMall.Drag.PredictedWeatherSource = 'ConstantFluxAndGeoMag';
GMAT FMall.Drag.F107 = 72;
GMAT FMall.Drag.F107A = 72;
GMAT FMall.Drag.MagneticIndex = 1.0;
GMAT FMall.SRP = On;
GMAT FMall.SRP.Flux = 1367;
GMAT FMall.SRP.SRPModel = Spherical;

Create Propagator PropAll;
GMAT PropAll.FM = FMall;
GMAT PropAll.Type = RungeKutta89;
GMAT PropAll.InitialStepSize = 10;
GMAT PropAll.Accuracy = 1e-12;
GMAT PropAll.MinStep = 0.001;
GMAT PropAll.MaxStep = 300;

Create ReportFile RepAll;
GMAT RepAll.Filename = 'crosscheck_fullforce_gmat.txt';
GMAT RepAll.Precision = 16;
GMAT RepAll.WriteHeaders = true;

BeginMissionSequence;

Report RepAll DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate PropAll(DefaultSC) {DefaultSC.ElapsedSecs = 5054.811};
Report RepAll DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate PropAll(DefaultSC) {DefaultSC.ElapsedSecs = 13827.074};
Report RepAll DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate PropAll(DefaultSC) {DefaultSC.ElapsedSecs = 13776.719};
Report RepAll DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate PropAll(DefaultSC) {DefaultSC.ElapsedSecs = 5004.760};
Report RepAll DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate PropAll(DefaultSC) {DefaultSC.ElapsedSecs = 5104.975};
Report RepAll DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate PropAll(DefaultSC) {DefaultSC.ElapsedSecs = 13875.094};
Report RepAll DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate PropAll(DefaultSC) {DefaultSC.ElapsedSecs = 13724.061};
Report RepAll DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate PropAll(DefaultSC) {DefaultSC.ElapsedSecs = 4954.841};
Report RepAll DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
