%General Mission Analysis Tool(GMAT) Script
%  Moon-only third-body validation: two-body Earth + Luna point mass.

Create Spacecraft DefaultSC;
GMAT DefaultSC.DateFormat = UTCGregorian;
GMAT DefaultSC.Epoch = '20 Sep 2016 00:00:00.000';
GMAT DefaultSC.CoordinateSystem = EarthMJ2000Eq;
GMAT DefaultSC.X = -6555.799000;
GMAT DefaultSC.Y = 0.000000;
GMAT DefaultSC.Z = 0.000000;
GMAT DefaultSC.VX = 0.000000000;
GMAT DefaultSC.VY = -9.058150532;
GMAT DefaultSC.VZ = -4.816304071;

Create ForceModel FMmoon;
GMAT FMmoon.CentralBody = Earth;
GMAT FMmoon.PointMasses = {Earth, Luna};

Create Propagator PropM;
GMAT PropM.FM = FMmoon;
GMAT PropM.Type = RungeKutta89;
GMAT PropM.InitialStepSize = 10;
GMAT PropM.Accuracy = 1e-12;
GMAT PropM.MaxStep = 300;

Create ReportFile RepM;
GMAT RepM.Filename = 'crosscheck_moononly_gmat.txt';
GMAT RepM.Precision = 16;
GMAT RepM.WriteHeaders = false;

BeginMissionSequence;

Propagate PropM(DefaultSC) {DefaultSC.ElapsedSecs = 18931.708};
Report RepM DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
Propagate PropM(DefaultSC) {DefaultSC.ElapsedSecs = 18932.211};
Report RepM DefaultSC.ElapsedSecs DefaultSC.EarthMJ2000Eq.X DefaultSC.EarthMJ2000Eq.Y DefaultSC.EarthMJ2000Eq.Z DefaultSC.EarthMJ2000Eq.VX DefaultSC.EarthMJ2000Eq.VY DefaultSC.EarthMJ2000Eq.VZ;
