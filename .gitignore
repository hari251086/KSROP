# -------------------------------------------------------
# KSROP — .gitignore
# -------------------------------------------------------

# Fortran compiled objects and modules
*.o
*.obj
*.slo
*.lo
*.mod
*.smod

# Precompiled headers
*.gch
*.pch

# Static and dynamic libraries
*.a
*.la
*.lai
*.lib
*.so
*.dylib
*.dll

# Executables and build artefacts
*.exe
*.app

# Intel Fortran specific
*.ilk
*.pdb
*.optrpt
*.i90

# Linker dependency files
*.d

# ------- Large geopotential data (intentionally not tracked) -------
input/EGM2008_to2190_TideFree

# ------- Runtime output files (written to output/) -------
output/*
!output/.gitkeep

# ------- Legacy output files in root (stale runs) -------
state.out
regular.out
kepler.out
ksrop.oem

# ------- GMAT crosscheck run outputs (scratch_gmat/) -------
scratch_gmat/*.oem
scratch_gmat/*ephem*.txt

# ------- Test infrastructure -------
# Backup files written by test_driver.py
_*.bak

# Python cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# ------- Local release-packaging staging area -------
dist/

# ------- Editor and OS noise -------
*.swp
*.swo
*~
.DS_Store
Thumbs.db
