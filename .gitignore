# -------------------------------------------------------
# KSROP — .gitignore
# -------------------------------------------------------

# Fortran compiled objects and modules
*.o
*.obj
*.slo
*.lo
*.mod
*.smod

# Precompiled headers
*.gch
*.pch

# Static and dynamic libraries
*.a
*.la
*.lai
*.lib
*.so
*.dylib
*.dll

# Executables and build artefacts
*.exe
*.app

# Intel Fortran specific
*.ilk
*.pdb
*.optrpt
*.i90

# Linker dependency files
*.d

# ------- Runtime output files (generated by driver_KS) -------
state.out
regular.out
kepler.out
ksrop.oem
ksrop.opm

# ------- Test infrastructure -------
# Backup files written by test_driver.py
_*.bak

# Python cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# ------- Editor and OS noise -------
*.swp
*.swo
*~
.DS_Store
Thumbs.db
